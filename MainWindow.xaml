<Window x:Class="FaceLockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaceLock - Multi-Angle Presence Protection"
        Height="800" Width="1080"
        MinHeight="720" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#121316"
        Foreground="#ECEFF4">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#262A35"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ==================== VIEW 1: PASSWORD AUTHENTICATION ==================== -->
        <Grid x:Name="AuthGrid" Background="#121316" Visibility="Visible">
            <Border Background="#1E222B" CornerRadius="16" Padding="40" 
                    Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#2D3342" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🛡️ FaceLock Security" FontSize="24" FontWeight="Bold" 
                               HorizontalAlignment="Center" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AuthSubtitle" Text="Enter master password to access system" 
                               FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Master Password" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordInput" Height="42" Background="#0F1115" Foreground="White"
                                 BorderBrush="#334155" BorderThickness="1" Padding="10,8" FontSize="15"
                                 KeyDown="PasswordInput_KeyDown"/>

                    <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed" Margin="0,15,0,0">
                        <TextBlock Text="Confirm Password" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="ConfirmPasswordInput" Height="42" Background="#0F1115" Foreground="White"
                                     BorderBrush="#334155" BorderThickness="1" Padding="10,8" FontSize="15"/>
                    </StackPanel>

                    <TextBlock x:Name="AuthErrorText" Foreground="#F87171" FontSize="12" Margin="0,12,0,0" 
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Button x:Name="SubmitAuthBtn" Content="Unlock Interface" Margin="0,22,0,0" 
                            Style="{StaticResource ModernBtn}" Click="SubmitAuthBtn_Click"/>

                    <TextBlock Text="🔒 Protection &amp; 3-second timer are disabled while locked." 
                               Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== VIEW 2: MAIN DASHBOARD ==================== -->
        <Grid x:Name="DashboardGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1A1D24" BorderBrush="#262A35" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ FaceLock" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border x:Name="StatusBadge" Margin="15,0,0,0" CornerRadius="12" Padding="12,4" Background="#334155" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadgeText" Text="Stopped" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔒 Lock UI &amp; Pause" Background="#334155" Style="{StaticResource ModernBtn}" 
                                Padding="12,6" FontSize="12" Click="LockUiBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Body: Two Columns -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*"/>
                    <ColumnDefinition Width="42*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Camera Feed & Controls -->
                <Grid Grid.Column="0" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Camera Viewport -->
                    <Border Grid.Row="0" Background="#0A0B0D" CornerRadius="12" 
                            BorderBrush="#262A35" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="CameraPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- 3-Second Arming Overlay -->
                            <Border x:Name="ArmingOverlay" Background="#D9000000" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="ARMING SYSTEM" Foreground="#94A3B8" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="CountdownNumberText" Text="3" Foreground="#60A5FA" FontSize="96" FontWeight="Black" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Position yourself in front of the camera" Foreground="#E2E8F0" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="CameraPlaceholder" Text="Camera Starting..." Foreground="#64748B" FontSize="18" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Primary Actions Under Camera -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CaptureSampleBtn" Grid.Column="0" Content="📷 Capture &amp; Add Photo" 
                                Style="{StaticResource SuccessBtn}" Margin="0,0,8,0" Click="CaptureSampleBtn_Click"/>

                        <Button x:Name="ToggleMonitorBtn" Grid.Column="1" Content="▶ Start Protection (3s delay)" 
                                Style="{StaticResource ModernBtn}" Margin="8,0,0,0" Click="ToggleMonitorBtn_Click"/>
                    </Grid>
                </Grid>

                <!-- Right Column: Photo Gallery & Settings -->
                <Grid Grid.Column="1" Margin="15,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Owner Photo Gallery Card -->
                    <Border Grid.Row="0" Background="#1A1D24" CornerRadius="12" Padding="16" Margin="0,0,0,12" 
                            BorderBrush="#262A35" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="REGISTERED OWNER PHOTOS" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <Border CornerRadius="10" Background="#262A35" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="PhotoCountText" Text="0 photos" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Gallery Items List -->
                            <ListBox x:Name="GalleryListBox" Grid.Row="1" Background="#0F1115" BorderBrush="#262A35" 
                                     BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="GalleryListBox_SelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="#1E222B" Margin="5" Padding="5" 
                                                BorderBrush="#334155" BorderThickness="1" Width="100">
                                            <StackPanel>
                                                <Image Source="{Binding DisplaySource}" Width="85" Height="85" Stretch="UniformToFill" 
                                                       ClipToBounds="True"/>
                                                <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="#94A3B8" 
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Gallery Actions -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DeleteSelectedBtn" Grid.Column="0" Content="🗑️ Delete Selected" 
                                        Style="{StaticResource DangerBtn}" Margin="0,0,6,0" IsEnabled="False" Click="DeleteSelectedBtn_Click"/>
                                <Button x:Name="ClearAllBtn" Grid.Column="1" Content="Clear All" 
                                        Background="#334155" Style="{StaticResource ModernBtn}" Margin="6,0,0,0" Click="ClearAllBtn_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Settings & Detection Controls -->
                    <Border Grid.Row="1" Background="#1A1D24" CornerRadius="12" Padding="16" BorderBrush="#262A35" BorderThickness="1">
                        <StackPanel>
                            <!-- Multi-Monitor Guidance Alert -->
                            <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" BorderBrush="#3B82F6" BorderThickness="1">
                                <TextBlock Text="💡 Multi-Monitor Tip: Turn your head towards your second monitor and click 'Capture &amp; Add Photo'. Adding snapshots for each screen angle allows continuous recognition." 
                                           Foreground="#93C5FD" FontSize="11" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Action Selection -->
                            <TextBlock Text="System Action when Face Missing:" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ActionComboBox" Background="#0F1115" Foreground="White" Height="32" SelectedIndex="0" 
                                      SelectionChanged="ActionComboBox_SelectionChanged" Margin="0,0,0,10">
                                <ComboBoxItem Content="Lock Workstation (Win+L - Recommended)"/>
                                <ComboBoxItem Content="Full User Logout (ExitWindowsEx)"/>
                            </ComboBox>

                            <!-- Lock Delay (Grace Period) -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Lock Trigger Delay (Tolerance):" FontSize="12" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="DelayLabel" Text="5 seconds" FontSize="12" Foreground="#60A5FA" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="DelaySlider" Minimum="2" Maximum="10" Value="5" 
                                    TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DelaySlider_ValueChanged" Margin="0,0,0,10"/>

                            <!-- Sensitivity Slider -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Match Sensitivity:" FontSize="12" Foreground="#CBD5E1"/>
                                <TextBlock x:Name="SensitivityLabel" Text="52%" FontSize="12" Foreground="#60A5FA" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="SensitivitySlider" Minimum="0.35" Maximum="0.80" Value="0.52" 
                                    TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="SensitivitySlider_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer Status Bar -->
            <Border Grid.Row="2" Background="#16181F" BorderBrush="#262A35" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <TextBlock x:Name="FooterStatusText" Text="Ready" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterConfidenceText" Text="" Foreground="#60A5FA" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
